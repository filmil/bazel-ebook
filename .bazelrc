common --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main
common --registry=https://bcr.bazel.build

try-import %workspace%/user.bazelrc

# rules_python starts a py_binary through a Python stage-1 script by default,
# which means "#!/usr/bin/env python3" and whatever python3 the machine has.
# The script bootstrap starts it from bash and uses the toolchain interpreter.
common --@rules_python//python/config_settings:bootstrap_impl=script

# The rootfs is a tree artifact full of directory symlinks and empty
# directories, and neither survives a round trip through a cache: a restored
# copy is missing what the fresh one had, and the next action to use it fails
# setting up its sandbox with "No such file or directory". Extract it every
# time; it takes a minute, and everything built from it still caches.
#
# The tag has to be no-cache. With no-remote-cache the disk cache still
# serves the tree, and CI has one: setup-bazel passes --disk_cache. A run
# whose extraction came from there failed on a path under
# usr/lib/x86_64-linux-gnu/perl that the restored tree did not have, in
# https://github.com/filmil/bazel-ebook/actions/runs/34212539812
build --modify_execution_info=xrootfs=+no-cache
