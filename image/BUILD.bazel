load("@bazel_rootfs//bin:defs.bzl", "rootfs_binary")
load("@bazel_rootfs//image:rules.bzl", "rootfs")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

package(default_visibility = ["//visibility:public"])

# A rootfs holding only the programs this repository needs and cannot get as an
# upstream binary release. Everything else comes from multitool or is built by
# Bazel.
oci_image(
    name = "image",
    architecture = "amd64",
    os = "linux",
    tars = ["@ebook_apt//:flat"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["bazel-ebook-tools:latest"],
)

filegroup(
    name = "image.tar",
    srcs = [":load"],
    output_group = "tarball",
)

rootfs(
    name = "rootfs",
    image_tar = ":image.tar",
    # Symlinks whose targets are not installed. Bazel rejects a dangling
    # symlink inside a tree artifact, so they are dropped during extraction.
    to_remove = [
        "etc/rmt",
        "usr/share/doc/libchm1/NEWS.gz",
        "usr/share/doc/openssl/copyright",
        "usr/share/doc/openssl/changelog.gz",
        "usr/share/doc/openssl/changelog.Debian.gz",
        "usr/lib/ssl/cert.pem",
        "usr/share/texlive/texmf-dist/tex/generic/config/language.dat",
        "usr/share/texlive/texmf-dist/tex/generic/config/language.def",
        "usr/share/texlive/texmf-dist/tex/generic/config/language.dat.lua",
        "usr/share/texlive/texmf-dist/ls-R",
        "usr/share/texmf/ls-R",
        "usr/share/ghostscript/10.02.1/Resource/CIDFSubst/DroidSansFallback.ttf",
        "usr/share/texmf/web2c/fmtutil.cnf",
        "usr/share/texlive/texmf-dist/web2c/fmtutil.cnf",
        "usr/share/texmf/web2c/updmap.cfg",
        "usr/share/doc/perl/Changes.gz",
        "usr/share/texlive/texmf-dist/web2c/updmap.cfg",
        "usr/share/zoneinfo/localtime",
        "usr/share/doc/libxml2/NEWS.gz",
        # Debian ships /usr/bin/X11 as a symlink to its own directory. Bazel
        # walks a tree artifact and gives up at "Too many levels of symbolic
        # links", so the loop has to go.
        "usr/bin/X11",
    ],
)

rootfs_binary(
    name = "drawtiming",
    binary_path = "/usr/bin/drawtiming",
    # drawtiming draws through ImageMagick, which loads its coder modules and
    # configuration from paths compiled into the library, not from anything on
    # PATH. Left alone it finds whichever ImageMagick the host happens to have,
    # or segfaults on a host that has none. Point it inside the rootfs.
    #
    # ImageMagick also builds its font list through fontconfig. With no
    # fontconfig configuration at all it prints "Cannot load default config
    # file" and then dereferences the null result; with a configuration that
    # names no font directory it fails to draw text at all. FONTCONFIG_PATH
    # supplies the configuration and XDG_DATA_HOME supplies the fonts: the
    # rootfs fonts.conf lists an xdg-prefixed "fonts" directory, which is the
    # one entry in it that can be redirected without rewriting the file.
    env = {
        "FONTCONFIG_PATH": "%ROOTFS%/etc/fonts",
        "MAGICK_CODER_MODULE_PATH": "%ROOTFS%/usr/lib/x86_64-linux-gnu/ImageMagick-6.9.12/modules-Q16/coders",
        "MAGICK_CONFIGURE_PATH": "%ROOTFS%/etc/ImageMagick-6",
        "MAGICK_FILTER_MODULE_PATH": "%ROOTFS%/usr/lib/x86_64-linux-gnu/ImageMagick-6.9.12/modules-Q16/filters",
        "XDG_DATA_HOME": "%ROOTFS%/usr/share",
    },
    rootfs = ":rootfs",
)

rootfs_binary(
    name = "asy",
    binary_path = "/usr/bin/asy",
    # asymptote will not start without being told where its module library
    # is, and it shells out to ghostscript to write PNG. Both live in the
    # rootfs, and a Bazel action has no PATH of its own to find them by.
    env = {
        "ASYMPTOTE_DIR": "%ROOTFS%/usr/share/asymptote",
        "ASYMPTOTE_GS": "%ROOTFS%/usr/bin/gs",
    },
    rootfs = ":rootfs",
)

rootfs_binary(
    name = "gladtex",
    binary_path = "/usr/bin/gladtex",
    rootfs = ":rootfs",
)

# asymptote shells out to ghostscript. Wrapped as its own target so asy is
# handed something it can exec, rather than a path inside the rootfs.
rootfs_binary(
    name = "gs",
    binary_path = "/usr/bin/gs",
    # Ghostscript looks for gs_init.ps and its resources under paths compiled
    # into the binary. On a machine that has ghostscript installed it finds the
    # host's and appears to work; on one that does not it stops with
    # "Can't find initialization file gs_init.ps". GS_LIB names them
    # explicitly so neither happens.
    env = {
        "GS_LIB": ":".join([
            "%ROOTFS%/usr/share/ghostscript/10.02.1/Resource/Init",
            "%ROOTFS%/usr/share/ghostscript/10.02.1/lib",
            "%ROOTFS%/usr/share/ghostscript/10.02.1/Resource/Font",
            "%ROOTFS%/usr/share/ghostscript/fonts",
        ]),
    },
    rootfs = ":rootfs",
)

rootfs_binary(
    name = "ebook-convert",
    binary_path = "/usr/bin/ebook-convert",
    # calibre ships its Python package outside the interpreter's own search
    # path, in /usr/lib/calibre, and its data separately again. Neither is
    # found without being named.
    # calibre keeps its Python package, its compiled extensions and its data
    # in three separate places, and honours an environment variable for each.
    # None of them are found from a rootfs without being named.
    env = {
        "CALIBRE_EXTENSIONS_PATH": "%ROOTFS%/usr/lib/calibre/calibre/plugins",
        "CALIBRE_PYTHON_PATH": "%ROOTFS%/usr/lib/calibre",
        "CALIBRE_RESOURCES_PATH": "%ROOTFS%/usr/share/calibre",
        "PYTHONPATH": "%ROOTFS%/usr/lib/calibre:%ROOTFS%/usr/lib/python3/dist-packages",
    },
    rootfs = ":rootfs",
)
