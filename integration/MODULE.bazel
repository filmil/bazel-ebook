module(
    name = "bazel_ebook_example",
    version = "0.0.1",
)

bazel_dep(name = "bazel_ebook", version = "0.0.5")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

local_path_override(
    module_name = "bazel_ebook",
    path = "../",
)

# The same override the parent module carries. An override in a module that is
# not the root is ignored, so this one has to be repeated here, or this build
# resolves bazel_rootfs 1.1.1 from the registry and gets a rootfs_binary
# without any of the fixes the ebook tools need. Both go away together, once a
# release carries them; tracked in #82.
git_override(
    module_name = "bazel_rootfs",
    commit = "7e33405537413e69aa54a66a83ee15e8fbb950e5",
    remote = "https://github.com/filmil/bazel_rootfs",
)

# graphviz is built from source, and bazel_ebook registers the toolchain that
# builds it as a dev_dependency -- which does not reach a module that depends
# on it. Without this the build falls back to whatever C compiler the machine
# has, which is the thing this repository is trying to stop doing.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

zig = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

bazel_ebook_extension = use_extension(
    "@bazel_ebook//:extensions.bzl",
    "bazel_ebook_extension",
)
use_repo(
    bazel_ebook_extension,
    "pandoc_crossref",
    "pandoc_ext_include_files",
)
