load("//build:rules.bzl", "ebook_pdf", "markdown_lib", "pandoc_chunked_html")

# Not built by `bazel build //...`.
#
# The Python plugin depends on go-tree-sitter, whose cgo does not link under
# lld: the parser package references ts_current_malloc, ts_current_realloc and
# ts_current_free without linking the tree-sitter runtime that defines them.
# GNU ld tolerates that, lld does not, and this repository compiles with the
# hermetic zig toolchain so that everyone gets the same compiler.
#
# This is developer tooling for regenerating BUILD files, not part of building
# a book, so it is marked manual rather than weakening the link settings for
# every target in the build.
gazelle_binary(
    name = "gazelle_multilang",
    languages = [
        # List of language plugins.
        # If you want to generate py_proto_library targets (PR #3057), then
        # the proto language plugin _must_ come before the rules_python plugin.
        #"@bazel_gazelle//language/proto",
        "@rules_python_gazelle_plugin//python",
    ],
    tags = ["manual"],
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = [
        "./.git/*",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_multilang",
    tags = ["manual"],
)

markdown_lib(
    name = "manual_src",
    srcs = [
        "//doc:readme_for_book",
        "empty.md",  # This shouldn't be happening.
        "//doc:md",
        "//tests:dot_png_test",
        "//tests:drawtiming_lib_test",
        "//tests:md",
        "//tests:plantuml_lib_test",
        "//tests/include-files:md",
    ],
    additional_inputs = [
        "//tests/include-files:md2",
    ],
)

pandoc_chunked_html(
    name = "bazel_ebook_html",
    filters = [
        "@pandoc_crossref//:pandoc_crossref",
    ],
    title = "Bazel Ebook Ebook",
    toc = True,
    deps = [
        ":manual_src",
    ],
)

ebook_pdf(
    name = "bazel_ebook_pdf",
    metadata_xml = "empty.xml",
    title_yaml = "empty.yaml",
    deps = [":manual_src"],
)

sh_test(
    name = "test",
    size = "small",
    srcs = ["test.bash"],
)

modules_mapping(
    name = "modules_map",
    include_stub_packages = True,
    wheels = all_whl_requirements,
)

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    modules_mapping = ":modules_map",
    pip_repository_name = "pip",
    requirements = "//:requirements_lock.txt",
)

compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
)
