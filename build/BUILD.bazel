load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load(":toolchain.bzl", "ebook_toolchain")

# The toolchain type the ebook rules resolve to reach their external programs.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The historical, container-based implementation. Every tool is a bare name
# resolved on the PATH inside the ebook-buildenv container, and each invocation
# is routed through rules_bid's docker_run.
ebook_toolchain(
    name = "docker_tools",
    tools = {
        "asy": "asy",
        "dot": "dot",
        "drawtiming": "drawtiming",
        "ebook-convert": "ebook-convert",
        "gladtex": "gladtex",
        # Absolute rather than bare, as it has always been here.
        "neato": "/usr/bin/neato",
        "pandoc": "pandoc",
        "plantuml": "plantuml",
    },
    visibility = ["//visibility:public"],
    wrapper = "@rules_bid//build:docker_run",
)

toolchain(
    name = "docker_toolchain",
    toolchain = ":docker_tools",
    toolchain_type = ":toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bazel_tools_bzl",
    srcs = [
        "@bazel_tools//tools/build_defs/repo:cache.bzl",
        "@bazel_tools//tools/build_defs/repo:git.bzl",
        "@bazel_tools//tools/build_defs/repo:git_worker.bzl",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "attrs_bzl",
    srcs = ["attrs.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "deps_bzl",
    srcs = ["deps.bzl"],
    visibility = ["//visibility:public"],
    deps = [":bazel_tools_bzl"],
)

bzl_library(
    name = "script_bzl",
    srcs = ["script.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@rules_bid//build:rules"],
)

bzl_library(
    name = "toolchain_bzl",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pandoc_metadata_bzl",
    srcs = ["pandoc_metadata.bzl"],
    visibility = ["//visibility:public"],
    deps = [":script_bzl"],
)

bzl_library(
    name = "pandoc_bzl",
    srcs = ["pandoc.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":attrs_bzl",
        ":providers_bzl",
        ":script_bzl",
        ":toolchain_bzl",
    ],
)

bzl_library(
    name = "repositories_bzl",
    srcs = ["repositories.bzl"],
    visibility = ["//visibility:public"],
    deps = [":bazel_tools_bzl"],
)

bzl_library(
    name = "rules_bzl",
    srcs = ["rules.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":attrs_bzl",
        ":pandoc_bzl",
        ":providers_bzl",
        ":script_bzl",
        ":toolchain_bzl",
        "@bazel_skylib//lib:paths",
    ],
)

BZL_FILES = [
    "attrs",
    "deps",
    "pandoc",
    "pandoc_metadata",
    "providers",
    "repositories",
    "rules",
    "script",
    "toolchain",
]

[
    stardoc(
        name = "{}_md".format(f),
        out = "gen.{}.md".format(f),
        input = "{}.bzl".format(f),
        deps = [":{}_bzl".format(f)],
    )
    for f in BZL_FILES
]

write_source_files(
    name = "update_docs",
    files = {
        "{}.md".format(f): ":{}_md".format(f)
        for f in BZL_FILES
    },
)
