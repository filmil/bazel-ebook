# These targets deliberately live in their own package rather than in //build.
#
# Registering a toolchain makes every consumer of this module load the package
# that declares it. //build loads @stardoc for its documentation targets, and
# stardoc is a dev_dependency -- invisible to consumers -- so putting the
# toolchain there broke any downstream build with:
#
#   No repository visible as '@stardoc' from repository '@@bazel_ebook+'
#
# Keep this package free of dev-only dependencies.

load("//build:toolchain.bzl", "ebook_toolchain")

# The toolchain type the ebook rules resolve to reach their external programs.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The default toolchain, part hermetic and part container-based.
#
# dot comes from the Bazel-native graphviz module and runs directly; it
# serves neato and the other engines too, selected with -K.
# Everything still named in `tools` is a bare name resolved on the PATH inside
# the ebook-buildenv container, reached through rules_bid's docker_run. Moving
# a tool from `tools` to `hermetic_tools` is what retires the container one
# program at a time.
ebook_toolchain(
    name = "default_tools",
    hermetic_tools = {
        # One binary serves every layout engine; the rules pass -K.
        "dot": "@graphviz//:dot",
        # The GraalVM native build, so no JVM is needed.
        "plantuml": "@multitool//tools/plantuml",
        # No upstream binary release, so it comes out of the Debian rootfs
        # built in //image.
        "drawtiming": "//image:drawtiming",
    },
    tools = {
        "asy": "asy",
        "ebook-convert": "ebook-convert",
        "gladtex": "gladtex",
        "pandoc": "pandoc",
    },
    visibility = ["//visibility:public"],
    wrapper = "@rules_bid//build:docker_run",
)

toolchain(
    name = "docker_toolchain",
    toolchain = ":default_tools",
    toolchain_type = ":toolchain_type",
    visibility = ["//visibility:public"],
)
