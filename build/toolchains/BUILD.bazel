# These targets deliberately live in their own package rather than in //build.
#
# Registering a toolchain makes every consumer of this module load the package
# that declares it. //build loads @stardoc for its documentation targets, and
# stardoc is a dev_dependency -- invisible to consumers -- so putting the
# toolchain there broke any downstream build with:
#
#   No repository visible as '@stardoc' from repository '@@bazel_ebook+'
#
# Keep this package free of dev-only dependencies.

load("//build:toolchain.bzl", "ebook_toolchain")

# The toolchain type the ebook rules resolve to reach their external programs.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The default toolchain. Every tool is provided by Bazel, so there is no
# `tools` map and no `wrapper`: nothing is left for a container to supply.
#
# dot comes from the Bazel-native graphviz module and serves neato and the
# other engines too, selected with -K.
ebook_toolchain(
    name = "default_tools",
    hermetic_tools = {
        # One binary serves every layout engine; the rules pass -K.
        "dot": "@graphviz//:dot",
        # The GraalVM native build, so no JVM is needed.
        "plantuml": "@multitool//tools/plantuml",
        # No upstream binary release, so these come out of the Debian rootfs
        # built in //image. asymptote and gladtex share most of a TeX closure,
        # which is why they are added together.
        "asy": "//image:asy",
        "drawtiming": "//image:drawtiming",
        "gladtex": "//image:gladtex",
        "gs": "//image:gs",
        "ebook-convert": "//image:ebook-convert",
        "pdflatex": "//image/bin:pdflatex",
        # pandoc-crossref must be built against the same pandoc; the pair in
        # multitool.lock.json is matched deliberately.
        "pandoc": "@multitool//tools/pandoc",
    },
    # pandoc starts rsvg-convert and pdflatex itself, so they have to be
    # findable by name rather than named as arguments.
    path_binaries = [
        "//image/bin:dvipng",
        "//image/bin:dvisvgm",
        "//image/bin:latex",
        "//image/bin:pdflatex",
        "//image/bin:rsvg-convert",
    ],
    path_roots = ["//image:rootfs"],
    # TeX comes out of the rootfs, but the formats pdflatex needs are made by
    # a maintainer script that never runs when a .deb is merely unpacked.
    texmf = "//image:texmf",
    # drawtiming asks ImageMagick for "Helvetica" and ImageMagick looks it up
    # in a font map full of absolute paths that exist only on an installed
    # Debian. Name a file in the rootfs instead.
    text_font = "usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    visibility = ["//visibility:public"],
)

toolchain(
    name = "docker_toolchain",
    toolchain = ":default_tools",
    toolchain_type = ":toolchain_type",
    visibility = ["//visibility:public"],
)
